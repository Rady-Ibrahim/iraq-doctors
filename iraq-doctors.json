    {
      "name": "📅 Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) pm.collectionVariables.set('appointment_id', String(json.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": {{doctor_id}},\n  \"schedule_id\": {{schedule_id}},\n  \"appointment_date\": \"2026-12-15\",\n  \"appointment_time\": \"10:00\",\n  \"notes\": \"زيارة أولى\"\n}"
            },
            "url": "{{base_url}}/api/v1/appointments"
          }
        },
        {
          "name": "My Appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const list = json.data || [];",
                  "  const completed = list.find(a => a.status === 'completed');",
                  "  if (completed) pm.collectionVariables.set('appointment_id', String(completed.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/appointments/my",
              "query": [{ "key": "status", "value": "", "disabled": true }]
            }
          }
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/appointments/{{appointment_id}}"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/appointments/{{appointment_id}}/cancel"
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_date\": \"2026-12-20\",\n  \"appointment_time\": \"14:00\",\n  \"schedule_id\": {{schedule_id}}\n}"
            },
            "url": "{{base_url}}/api/v1/appointments/{{appointment_id}}/reschedule"
          }
        }
      ]
