        },
        {
          "name": "Search Pharmacies — يحفظ pharmacy_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const list = json.data || [];",
                  "  if (list.length > 0) {",
                  "    pm.collectionVariables.set('pharmacy_id', String(list[0].id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/v1/pharmacies?page=1&limit=10"
          }
        },
        {
          "name": "Pharmacy Medicines — يحفظ pharmacy_medicine_id و medicine_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const list = json.data || [];",
                  "  if (list.length > 0) {",
                  "    pm.collectionVariables.set('pharmacy_medicine_id', String(list[0].id));",
                  "    if (list[0].medicine_id) pm.collectionVariables.set('medicine_id', String(list[0].medicine_id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/v1/pharmacies/{{pharmacy_id}}/medicines"
          }
        }
      ]
    },
