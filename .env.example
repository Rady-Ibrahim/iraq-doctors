APP_NAME="أطباء العراق"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_IQ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iraq_doctors
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# جلسات منفصلة للأدمن والدكتور والمعمل والصيدلية (نفس المتصفح — tab لكل لوحة)
ADMIN_SESSION_COOKIE=iraq_doctors_admin_session
DOCTOR_SESSION_COOKIE=iraq_doctors_doctor_session
LABORATORY_SESSION_COOKIE=iraq_doctors_laboratory_session
PHARMACY_SESSION_COOKIE=iraq_doctors_pharmacy_session

# OneSignal — push لتطبيق المريض (موبايل) فقط
ONESIGNAL_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# أحجام الرفع (كيلوبايت — 10240 = 10 ميجا)
UPLOAD_MAX_IMAGE_KB=10240
UPLOAD_MAX_DOCUMENT_KB=10240

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# OTP — وضع التطوير (يرجع الكود في response — محلي فقط)
OTP_EXPOSE_CODE_IN_RESPONSE=true
OTP_EXPIRES_MINUTES=10

# Firebase — اختياري (لم يعد مطلوباً لتفعيل الهاتف في Flutter)
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json

# Web API Key — إن لم تجده في Console شغّل: php artisan firebase:setup-web
# (ينشئ تطبيق Web ويحفظ المفتاح في storage/app/firebase/firebase-web-config.json)
FIREBASE_WEB_API_KEY=

# اختياري — يُشتق تلقائياً من project_id في ملف credentials إن تُرك فارغاً
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# أرقام الهاتف — 964 عراق، 20 مصر (للاختبار)
PHONE_DEFAULT_COUNTRY=964
PHONE_SUPPORTED_COUNTRIES=964,20

# وضع اختبار Postman (محلي فقط — لا تفعّل على production)
FIREBASE_AUTH_TEST_MODE=true
FIREBASE_AUTH_TEST_KEY=postman-local-secret-change-me
