{
  "info": {
    "_postman_id": "a1b2c3d4-wasender-otp-mobile",
    "name": "Iraq Doctors — Mobile Auth (Wasender OTP)",
    "description": "مصادقة المريض عبر واتساب OTP (بدون Firebase Auth).\n\n## التدفق\n1. Register → ينشئ حساب فقط (بدون OTP)\n2. Send OTP (phone_verify)\n3. Verify OTP (phone_verify)\n4. Login (phone + password) → يرجع token\n5. Me\n\nبدون تفعيل الهاتف: Login يرجع 403 PHONE_NOT_VERIFIED",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "phone", "value": "07901234567" },
    { "key": "otp_code", "value": "" },
    { "key": "password", "value": "Password123" },
    { "key": "name", "value": "مريض تجريبي" }
  ],
  "item": [
    {
      "name": "1. Register then verify then login",
      "item": [
        {
          "name": "1.1 Register patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('created', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.test('needs verify', () => pm.expect(json.data.requires_phone_verification).to.eql(true));",
                  "pm.test('no otp on register', () => pm.expect(json.data.otp).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "ينشئ حساب مريض فقط — بدون إرسال OTP. التفعيل عبر send-otp قبل اللوجين."
          }
        },
        {
          "name": "1.2 Login before verify (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('blocked', () => pm.expect(pm.response.code).to.eql(403));",
                  "pm.test('code', () => pm.expect(json.error.code).to.eql('PHONE_NOT_VERIFIED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "1.3 Send OTP (phone_verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "if (json.data && json.data.code) {",
                  "  pm.collectionVariables.set('otp_code', String(json.data.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"phone_verify\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/send-otp"
          }
        },
        {
          "name": "1.4 Verify OTP (phone_verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('verified', () => pm.expect(json.data.verified).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{otp_code}}\",\n  \"type\": \"phone_verify\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/verify-otp"
          }
        },
        {
          "name": "1.5 Login (returns token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has token', () => pm.expect(json.data.token).to.be.a('string'));",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "1.6 Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Forgot / Reset password",
      "item": [
        {
          "name": "2.1 Forgot password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.code) {",
                  "  pm.collectionVariables.set('otp_code', String(json.data.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "2.2 Reset password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{otp_code}}\",\n  \"new_password\": \"{{password}}\",\n  \"new_password_confirmation\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "3. Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/api/v1/auth/logout"
      }
    }
  ]
}
