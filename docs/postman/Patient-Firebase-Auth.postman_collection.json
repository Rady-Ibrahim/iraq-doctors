{
  "info": {
    "name": "Iraq Doctors — Patient Firebase Auth (Test Mode)",
    "description": "Simulates mobile patient auth without real Firebase tokens.\nRequires APP_ENV=local and FIREBASE_AUTH_TEST_MODE=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "test_key", "value": "postman-local-secret-change-me" },
    { "key": "token", "value": "" },
    { "key": "phone", "value": "07909998877" },
    { "key": "phone_egypt", "value": "01020578795" }
  ],
  "item": [
    {
      "name": "1. Register (new patient)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}",
              "pm.test('registered', () => pm.expect(json.data.is_new_user).to.eql(true));",
              "pm.test('phone E.164', () => pm.expect(json.data.user.phone).to.match(/^\\+9647/));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Auth-Test-Key", "value": "{{test_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"name\": \"مريض تجريبي\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/firebase"
      }
    },
    {
      "name": "2. Login (existing patient)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}",
              "pm.test('login', () => pm.expect(json.data.is_new_user).to.eql(false));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Auth-Test-Key", "value": "{{test_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/firebase"
      }
    },
    {
      "name": "3. Me (profile)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/api/v1/auth/me"
      }
    },
    {
      "name": "4. Register device (OneSignal)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"test-onesignal-player-id\",\n  \"platform\": \"android\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/devices/register"
      }
    },
    {
      "name": "5. Wrong app (doctor phone — expect 403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Auth-Test-Key", "value": "{{test_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"0770000000\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/firebase"
      }
    },
    {
      "name": "6. Register Egyptian patient (test mode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}",
              "pm.test('Egypt E.164', () => pm.expect(json.data.user.phone).to.match(/^\\+201/));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Auth-Test-Key", "value": "{{test_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone_egypt}}\",\n  \"name\": \"مريض مصري تجريبي\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/firebase"
      }
    }
  ]
}
